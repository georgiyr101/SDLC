@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam BackgroundColor white
title Регистрация операции, обновление баланса и расчёт лимита (UC-02, UC-09, UC-04)

actor Пользователь as U
participant "Контроллер операций" as C
participant "Сервис операций" as S
participant "Автокатегоризатор" as M
participant "Репозиторий счетов" as AR
participant "Репозиторий операций" as TR
database "База данных" as DB

U -> C : Отправить новую операцию (счёт, сумма, тип, описание)
activate C
C -> C : Проверить токен доступа, владельца и поля формы
C -> S : Запрос на создание операции для текущего пользователя
activate S
S -> AR : Найти и заблокировать активный счёт владельца
activate AR
AR -> DB : Запросить активный счёт с блокировкой на время транзакции
activate DB
DB --> AR : Данные счёта или пустой результат
deactivate DB
AR --> S : Результат поиска счёта
deactivate AR
note over S : Все денежные расчёты округляются точно без потери копеек

alt Счёт не найден, чужой или в архиве
  S --> C : Ошибка: счёт недоступен
  C --> U : Сообщение об ошибке; данные не изменены
else Счёт подтверждён и активен
  opt Категория не указана пользователем
    S -> M : Подобрать категорию по ключевым словам описания
    activate M
    M --> S : Найденная категория или «Прочее»
    deactivate M
  end

  S -> TR : Сохранить запись об операции с точной суммой
  activate TR
  TR -> DB : Вставить новую операцию
  activate DB
  DB --> TR : Запись сохранена
  deactivate DB
  TR --> S : Созданная операция
  deactivate TR

  S -> AR : Обновить текущий баланс счёта
  activate AR
  AR -> DB : Записать новый остаток по счёту
  activate DB
  DB --> AR : Баланс обновлён
  deactivate DB
  AR --> S : Обновление подтверждено
  deactivate AR

  ref over S, DB : Пересчёт лимита месяца (%), светофора и отправка Push (UC-09, UC-04)
  S --> C : Зафиксировать транзакцию; вернуть данные операции
  C --> U : Операция сохранена; показан обновлённый баланс
end
deactivate S
deactivate C
note over S, DB : При сбое базы данных все изменения отменяются целиком
@enduml
