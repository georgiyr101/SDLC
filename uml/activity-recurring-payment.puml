@startuml
skinparam shadowing false
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #334E96
title Выполнение регулярных платежей по расписанию (UC-05, UC-09, UC-04)

start
:Наступило 03:00 (планировщик времени)<
:Выбрать все активные правила из базы данных;
if (Активные правила найдены?) then (нет)
    :Записать в журнал «Правила к списанию отсутствуют»;
    stop
endif
repeat :Взять очередное правило;
    :Определить день списания\n(для короткого месяца — последний день);
    if (Срок наступил сегодня?) then (нет)
        :Пропустить правило (ожидает даты);
    else (да)
        if (Платёж уже выполнен в этом периоде?) then (да)
            :Пропустить правило\n(защита от повторного списания);
        else (нет)
            :Открыть транзакцию базы данных;
            note right
                Денежные расчёты выполняются с точным округлением.
                Ошибка одного правила не останавливает цикл.
            end note
            if (Целевой счёт активен?) then (да)
                :Создать операцию расхода;
                :Уменьшить баланс счёта;
                :Записать дату последнего списания;
                :Пересчитать лимит месяца (%);
                if (Порог 80% или 100% преодолён впервые?) then (да)
                    :Отправить Push в службу уведомлений;
                endif
                :Сохранить транзакцию в базе данных;
            else (нет)
                :Отменить операцию только для этого правила;
                :Записать ошибку в журнал (без сумм);
            endif
        endif
    endif
repeat while (Есть ещё правила?) is (да) not (нет)
:Записать итоговую сводку запуска в журнал;
stop
@enduml
